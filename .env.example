# Eco-Travel Advisor - environment variable template.
# Copy this file to `.env` (never commit the real .env) and fill in your own values.

# Contact address sent in the User-Agent header to Nominatim and Overpass.
# Their usage policies require it.
CONTACT_EMAIL=

# Climatiq carbon estimation API key (free tier, no card needed).
# https://www.climatiq.io/ -> Dashboard -> API Keys. Without a key the bot
# uses the local DESNZ 2026 factor table in server/mock_data/carbon_factors.json.
CLIMATIQ_API_KEY=

# Optional: pin the Climatiq data release (default "^6", see carbon_factors.json).
CLIMATIQ_DATA_VERSION=

# Optional: POST each human-handover package (JSON) to this URL, e.g. a
# helpdesk or Slack workflow webhook. Packages are always written to
# server/rasa/data/handover_log.jsonl as well.
HANDOVER_WEBHOOK_URL=

# Optional: timeout in seconds for live API calls made during a conversation
# turn (Climatiq, Nominatim, Open-Meteo, Frankfurter). Default 2.5 keeps
# replies under the 3-second latency requirement.
LIVE_API_TIMEOUT=2.5
